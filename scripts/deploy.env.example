# Copy this file to scripts/deploy.env (which is ignored) and fill in the
# addresses for the machines that are part of this deployment.
# Keep credentials out of this file; use SSH keys and each device's connector.env.

SWATH_DEPLOY_BRANCH=main
SWATH_REMOTE_USER=swath
SWATH_REMOTE_ROOT=/home/swath/Swath
SWATH_SERVER_HOST=catalog.example.internal
SWATH_SCYTHE_HOST=desktop.example.internal

# Optional overrides for a non-standard service or desktop launcher.
# SWATH_SERVER_SERVICE=swath-headless
# SWATH_DESKTOP_SERVICE=swath-desktop
